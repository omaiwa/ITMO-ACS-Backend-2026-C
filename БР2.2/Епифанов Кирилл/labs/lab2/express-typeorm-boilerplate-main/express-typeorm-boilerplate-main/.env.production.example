# Copy to .env on the server and replace all CHANGE_ME values.
# Used with: docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env up -d --build

# PostgreSQL (shared instance, database-per-service inside)
POSTGRES_USER=rental
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=rental

# Application secrets — generate unique values for production
JWT_SECRET_KEY=CHANGE_ME_long_random_jwt_secret
INTERNAL_SERVICE_TOKEN=CHANGE_ME_long_random_internal_token

# RabbitMQ (default guest credentials inside Docker network only)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
