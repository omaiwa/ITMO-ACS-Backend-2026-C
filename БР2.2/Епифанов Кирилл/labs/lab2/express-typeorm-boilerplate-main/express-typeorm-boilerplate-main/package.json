{
  "name": "@rental/root",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/common",
    "src/services/auth-service",
    "src/services/user-service",
    "src/services/property-service",
    "src/services/booking-service",
    "src/services/messsaging-service"
  ],
  "scripts": {
    "build": "tsc",
    "dev:db": "docker compose up db rabbitmq -d",
    "dev": "turbo run dev",
    "dev:gateway": "npx tsx --env-file=.env --watch src/gateway/index.ts",
    "start": "docker compose up --build",
    "start:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env up -d --build",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "class-validator-jsonschema": "^5.0.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.14.0",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "0.11.0",
    "routing-controllers-openapi": "github:kantegory/routing-controllers-openapi#115ce4c6bf8d0ab123ce2a372a608db6f2d2573c",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.21"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.19.15",
    "@types/swagger-ui-express": "^4.1.8",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.2"
  },
  "optionalDependencies": {
    "http-proxy-middleware": "^3.0.3"
  }
}
